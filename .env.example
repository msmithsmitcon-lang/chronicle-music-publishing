# Chronicle Creative Operations Portal V1 environment template
# Copy to .env.local for local development. Do not commit real secrets.

# Clerk authentication
# Local-only portal bypass. Only works in `NODE_ENV=development`.
# Production and preview must use Clerk authentication.
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal

# PostgreSQL / Prisma
DATABASE_URL=

# Application environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
